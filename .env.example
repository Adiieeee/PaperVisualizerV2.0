# Salin file ini menjadi `.env` lalu isi dengan key Anda sendiri.
# JANGAN PERNAH commit `.env` (sudah di-.gitignore). Buat key gratis di https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Opsional: fallback ke Groq saat kuota Gemini habis (key gratis di https://console.groq.com/keys).
# Kosongkan GROQ_API_KEY atau GROQ_MODEL untuk menonaktifkan fallback.
GROQ_API_KEY=
# Nama model memakai prefix provider LiteLLM. Cek model aktif + free di dashboard masing-masing.
GEMINI_MODEL=gemini/gemini-flash-lite-latest
GROQ_MODEL=
# Device embedding lokal: auto (GPU bila torch versi CUDA terpasang) | cpu | cuda
EMBEDDING_DEVICE=auto
