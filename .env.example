# Copy this file to `.env` and fill in your own keys.
# NEVER commit `.env` (it is already in .gitignore). Create a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: fall back to Groq when the Gemini quota runs out (free key at https://console.groq.com/keys).
# Leave GROQ_API_KEY or GROQ_MODEL empty to disable the fallback.
GROQ_API_KEY=
# Model names use the LiteLLM provider prefix. Check the currently active + free models on each provider's dashboard.
GEMINI_MODEL=gemini/gemini-flash-lite-latest
GROQ_MODEL=
# Local embedding device: auto (GPU if a CUDA build of torch is installed) | cpu | cuda
EMBEDDING_DEVICE=auto
# Background from Wikipedia/arXiv for "what is X?" questions (only the entity name is sent): on | off
EXTERNAL_CONTEXT=on
