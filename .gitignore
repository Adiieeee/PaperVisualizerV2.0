# Environments (secrets: never commit; .env.example is the only tracked template)
.env
.env.*
!.env.example
.venv/
venv/
env/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg

# Data
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Corpus backups (hasil build yang disimpan supaya tidak perlu rebuild)
backups/

# Local tooling / logs / test caches (berisi path lokal atau teks pertanyaan pengguna)
.claude/settings.local.json
logs/
.pytest_cache/

# Dokumen internal (rencana, keamanan, laporan magang) — hanya lokal
docs/SECURITY.md
docs/LAPORAN_*.md
PLAN_*.md

# IDEs & OS Files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Output evaluate.py --e2e yang dialihkan ke file (lokal)
e2e_*.txt
