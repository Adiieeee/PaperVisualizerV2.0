# Environments (secrets: never commit; .env.example is the only tracked template)
.env
.env.*
!.env.example
.venv/
venv/
env/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg

# Data
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Corpus backups (build results kept so there is no need to rebuild)
backups/

# Local tooling / logs / test caches (contain local paths or users' question text)
.claude/settings.local.json
logs/
.pytest_cache/

# Internal documents (plans, security, internship report) — local only
docs/SECURITY.md
docs/LAPORAN_*.md

# IDEs & OS Files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Output of evaluate.py --e2e redirected to a file (local)
e2e_*.txt
